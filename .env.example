# Set this once a portfolio domain is available. Leave empty until then.
NEXT_PUBLIC_SITE_URL=

# Optional: Web3Forms access key (get one free at https://web3forms.com). Contact form messages are emailed to you.
# It's public by design (it ends up in the page). Leave empty to show an unavailable message with direct email contact.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
